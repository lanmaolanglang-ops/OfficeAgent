{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OfficeAgent",
  "version": "0.51.1",
  "identifier": "com.officeagent.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OfficeAgent - 智能办公助手",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Light",
        "backgroundColor": "#f6f8fb",
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'",
      "capabilities": ["default"]
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "OfficeAgent - 智能办公助手",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "resources": {
      "../../dist/OfficeAgent/": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "AI智能办公助手",
    "longDescription": "OfficeAgent是一款AI驱动的智能办公助手，支持Word排版、PPT生成、Excel数据分析等功能。",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "Word Document",
        "description": "Microsoft Word Document"
      },
      {
        "ext": ["pptx"],
        "name": "PowerPoint Presentation",
        "description": "Microsoft PowerPoint Presentation"
      },
      {
        "ext": ["xlsx"],
        "name": "Excel Spreadsheet",
        "description": "Microsoft Excel Spreadsheet"
      }
    ]
  }
}
